{
  "rewrites": [
    {
      "source": "/referral-proxy/:path*",
      "destination": "https://api.mycampushut.com/referral/:path*"
    },
    {
      "source": "/news-proxy/:path*",
      "destination": "https://api.mycampushut.com/campusHutNews/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
